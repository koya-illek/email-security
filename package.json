{
  "name": "email-security-checker",
  "version": "1.0.0",
  "description": "Cloudflare Worker for standards-based email security posture checks",
  "main": "worker.js",
  "scripts": {
    "test": "npm run test:spf && npm run test:headers && npm run test:integration && npm run test:security",
    "check": "wrangler deploy --dry-run",
    "test:spf": "node --test test/rfc7208.cjs",
    "test:headers": "node --test test/header-analysis.cjs",
    "test:browser": "playwright test",
    "test:integration": "node test/conformance.mjs"
    ,"test:security": "node --test test/worker-security.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "mailauth": "^4.13.3",
    "tldts": "^7.4.9"
  },
  "overrides": {
    "nodemailer": "9.0.1",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "js-yaml": "^4.3.0",
    "wrangler": "^4.114.0"
  }
}
