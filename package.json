{
  "name": "email-security-checker",
  "version": "2.0.0",
  "description": "Cloudflare Worker for standards-based email security posture checks",
  "main": "worker.js",
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "test": "npm run test:spf && npm run test:headers && npm run test:integration && npm run test:retention && npm run test:security && npm run test:mcp && npm run test:domain-validation && npm run test:mta-sts && npm run test:scoring && npm run test:report-store && npm run test:policy-tags && npm run test:dmarc-reporting && npm run test:release",
    "check": "wrangler deploy --dry-run",
    "audit:html": "node scripts/audit-html.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:spf": "node --test test/rfc7208.cjs",
    "test:headers": "node --test test/header-analysis.cjs",
    "test:browser": "playwright test",
    "test:integration": "wrangler d1 execute email-security-reports --local --file=schema.sql && node test/conformance.mjs",
    "test:retention": "node --test test/retention.test.cjs",
    "test:security": "node --test test/worker-security.test.mjs test/redirects.test.cjs",
    "test:mcp": "node --test test/mcp.test.mjs",
    "test:domain-validation": "node --test test/domain-validation.test.cjs",
    "test:mta-sts": "node --test test/mta-sts.test.cjs",
    "test:scoring": "node --test test/scoring.test.cjs",
    "test:report-store": "node --test test/report-store.test.mjs",
    "test:policy-tags": "node --test test/policy-tags.test.mjs",
    "test:dmarc-reporting": "node --test test/dmarc-reporting.test.mjs",
    "test:release": "node --test test/release-check.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ipaddr.js": "^2.4.0",
    "mailauth": "^4.13.3",
    "tldts": "^7.4.9"
  },
  "overrides": {
    "nodemailer": "^9.1.1",
    "undici": "7.29.0",
    "joi": "^18.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "js-yaml": "^4.3.0",
    "wrangler": "^4.123.0"
  }
}
